{
  "name": "@xinvxueyuan/novelai-image-sdk",
  "version": "0.1.0",
  "description": "NovelAI image-generation SDK with Chrome-fingerprinted transport",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "optionalDependencies": {
    "@xinvxueyuan/novelai-image-sdk-win32-x64-msvc": "0.1.6",
    "@xinvxueyuan/novelai-image-sdk-linux-x64-gnu": "0.1.6",
    "@xinvxueyuan/novelai-image-sdk-linux-arm64-gnu": "0.1.6",
    "@xinvxueyuan/novelai-image-sdk-darwin-arm64": "0.1.6",
    "@xinvxueyuan/novelai-image-sdk-darwin-x64": "0.1.6"
  },
  "napi": {
    "binaryName": "novelai_image_ffi_napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin"
    ]
  },
  "keywords": [
    "novelai",
    "image-generation",
    "diffusion",
    "api-client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinvxueyuan/NovelAI-Image-SDK.git"
  },
  "scripts": {
    "build": "napi build --release",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  }
}
