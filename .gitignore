# Rust
/target/
**/*.rs.bk

# Generated bindings (produced from the built cdylib in CI)
bindings/*/generated/
bindings/*/__pycache__/
bindings/node/*.node
bindings/node/npm/
bindings/swift/*.xcframework/
bindings/dotnet/bin/
bindings/dotnet/obj/
bindings/go/internal/nativelib/*/*.a
bindings/go/internal/nativelib/*/*.lib
bindings/cpp/build/

# Python
__pycache__/
*.egg-info/
.venv/

# Node
node_modules/
npm-debug.log*

# Tooling artifacts
fixtures/golden/.generated-at
docs/book/
# Test scratch space
/tmp-bindings/

# Submodule build artifacts (created by the golden-fixture job)
third_party/novelai-image-mcp/.venv/
third_party/novelai-image-mcp/node_modules/

# prek-managed hook shims (generated by `prek install`; see prek.toml).
# `commit-msg.legacy` is our own gitmoji validator, kept in the repository.
.githooks/pre-commit
.githooks/pre-push
.githooks/commit-msg

# Packaging outputs
bindings/python/dist/
bindings/python/build/
bindings/python/*.egg-info/
bindings/python/novelai_image_sdk/novelai_image_sdk_ffi.py
bindings/python/novelai_image_sdk/*.dll
bindings/python/novelai_image_sdk/*.so
bindings/python/novelai_image_sdk/*.dylib
bindings/python/LICENSE
bindings/node/node_modules/
bindings/node/*.node
bindings/node/index.d.ts
bindings/node/package-lock.json
bindings/node/target/
.venv-packaging/
.venv-wheel-test/
bindings/kotlin/build/
# Native libraries are build outputs; the release job supplies them.
bindings/kotlin/src/main/resources/*/
bindings/kotlin/.gradle/
bindings/kotlin/.kotlin/
