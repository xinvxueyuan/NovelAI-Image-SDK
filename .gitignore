# Rust
/target/
**/*.rs.bk

# Generated bindings (produced from the built cdylib in CI)
bindings/*/generated/
bindings/*/__pycache__/
bindings/node/*.node
bindings/node/npm/
bindings/swift/*.xcframework/
bindings/dotnet/bin/
bindings/dotnet/obj/
bindings/go/internal/nativelib/*/*.a
bindings/go/internal/nativelib/*/*.lib
bindings/cpp/build/

# Python
__pycache__/
*.egg-info/
.venv/

# Node
node_modules/
npm-debug.log*

# Tooling artifacts
fixtures/golden/.generated-at
docs/book/
# Test scratch space
/tmp-bindings/

# Submodule build artifacts (created by the golden-fixture job)
third_party/novelai-image-mcp/.venv/
third_party/novelai-image-mcp/node_modules/

# prek-managed hook shims (generated by `prek install`; see prek.toml).
# `commit-msg.legacy` is our own gitmoji validator, kept in the repository.
.githooks/pre-commit
.githooks/pre-push
.githooks/commit-msg
